# ==========================================
# Cognitive State Compilation (CSC) LLM Config
# ==========================================

# Option 1: OpenAI (Default)
LLM_API_KEY=your_openai_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Option 2: Google Gemini (Free tier available at https://aistudio.google.com/)
# LLM_API_KEY=your_gemini_api_key_here
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash

# Option 3: Groq Cloud (Free tier available at https://console.groq.com/)
# LLM_API_KEY=your_groq_api_key_here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Option 4: Local Ollama (100% Free, runs on your machine)
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2:3b
